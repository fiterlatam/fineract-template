    "item": [
        {
            "name": "List Loan Products",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test( \"Obtain Client ID\", function(){\r",
                            "    pm.response.to.have.status(200);\r",
                            "    pm.expect(pm.response.text()).to.not.equals( null );\r",
                            "    var jsonData = JSON.parse(pm.response.text());\r",
                            "\r",
                            "    postman.setEnvironmentVariable(\"clientId\", jsonData.resourceId);\r",
                            "} );"
                        ],
                        "type": "text/javascript",
                        "packages": {}
                    }
                },
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "var moment = require(\"moment\");\r",
                            "pm.environment.set(\"executionId\", moment().format((\"YYYYMMDD-HHmmss\")));\r",
                            "\r",
                            "generateNIT();\r",
                            "\r",
                            "generateDPI();\t\r",
                            "\t\r",
                            "function generateDPI() {\r",
                            "    var moment = require(\"moment\");\r",
                            "    var formatedMoment = moment().format((\"HHmmssSSS\"));\r",
                            "    formatedMoment = formatedMoment.substring(1);\r",
                            "    var generatedDPI = formatedMoment + parseModuleNumber(formatedMoment) + \"0111\";\r",
                            "\r",
                            "    console.log(generatedDPI);\r",
                            "\r",
                            "    pm.environment.set(\"generatedDPI\", generatedDPI);\r",
                            "}\r",
                            "\r",
                            "function parseModuleNumber(cleanDPINumber) {\r",
                            "    var total = 0;\r",
                            "    for (var i = 0; i < cleanDPINumber.length; i++) {\r",
                            "        total += parseInt(cleanDPINumber.substring(i, i + 1)) * (i + 2);\r",
                            "    }\r",
                            "    var ret = parseInt(total % 11);\r",
                            "    return (ret >= 10 ? 0 : ret);\r",
                            "}\t\r",
                            "\t\r",
                            "function generateNIT() {\r",
                            "    var moment = require(\"moment\");\r",
                            "    var formatedMoment = moment().format((\"MMDDHHmmss\"));\r",
                            "    var digitWeight = formatedMoment.length + 1;\r",
                            "\r",
                            "    var totalValue = 0;\r",
                            "\r",
                            "    for (var i = 0; i < formatedMoment.length; i++) {\r",
                            "        if(digitWeight == 1) {\r",
                            "            break\r",
                            "        }\r",
                            "        totalValue += parseInt(formatedMoment.charAt(i)) * digitWeight;\r",
                            "        digitWeight--;\r",
                            "    }\r",
                            "\r",
                            "    var generatedNIT = formatedMoment + '-'+ calculateNITDigit(totalValue);\r",
                            "\r",
                            "    if(generatedNIT.endsWith(\"0\")) {\r",
                            "        setTimeout(function() { generateNIT(); }, 321);\r",
                            "    }\r",
                            "\r",
                            "    console.log(generatedNIT);\r",
                            "\r",
                            "    pm.environment.set(\"generatedNIT\", generatedNIT);\r",
                            "}\r",
                            "\r",
                            "function calculateNITDigit(totalValue) {\r",
                            "    var digit = (11 - parseInt(totalValue % 11));\r",
                            "    if(digit  >= 10) {\r",
                            "        digit = 0;\r",
                            "    }\r",
                            "    return digit;\r",
                            "}\r",
                            ""
                        ],
                        "type": "text/javascript",
                        "packages": {}
                    }
                }
            ],
            "protocolProfileBehavior": {
                "disableBodyPruning": true
            },
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{authorization_token}}",
                        "type": "text"
                    },
                    {
                        "key": "Fineract-Platform-TenantId",
                        "value": "default",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\r\n    \"officeId\": 1,\r\n    \"legalFormId\": 1,\r\n    \"isStaff\": false,\r\n    \"active\": true,\r\n    \"dateOfBirth\": \"11/01/2020\",\r\n    \"submittedOnDate\": \"11/01/2020\",\r\n    \"genderId\": 1261,\r\n    \"firstname\": \"Bot++\",\r\n    \"externalId\": \"{{executionId}}\", \r\n    \"lastname\": \"CRRedPri {{executionId}}\",\r\n    \"activationDate\": \"11/01/2020\",\r\n    \"familyMembers\": [],\r\n    \"dateFormat\": \"dd/MM/yyyy\",\r\n    \"locale\": \"en\",\r\n    \"datatables\": [\r\n        {\r\n            \"registeredTableName\": \"campos_cliente_persona\",\r\n            \"data\": {\r\n                \"Cedula\": \"{{executionId}}\",\r\n                \"Estado Civil_cd_Estado civil\": 2404,\r\n                \"Edad\": \"\",\r\n                \"Estrato\": \"\",\r\n                \"Ciudad_cd_Ciudad\": 830,\r\n                \"Tiene vehiculo propio\": \"\",\r\n                \"Tipo Vehiculo_cd_Tipo de vehiculo\": \"\",\r\n                \"Nivel Academico_cd_Nivel academico\": \"\",\r\n                \"Actividad Laboral_cd_Actividad laboral\": \"\",\r\n                \"Tiempo de actividad laboral\": \"\",\r\n                \"Media de ingresos\": \"\",\r\n                \"Nombre empresa\": \"\",\r\n                \"Direccion\": \"Calle Uno, 57\",\r\n                \"Telefono\": \"2222-3355\",\r\n                \"Cupo solicitado\": 999999999,\r\n                \"Cupo aprobado\": 999999999,\r\n                \"Cupo otros prestamos\": \"999999999\",\r\n                \"Cupo score\": \"\",\r\n                \"Valor score\": \"\",\r\n                \"Modelo score\": \"\",\r\n                \"Customer Identifier_cd_Tipo identificacion\": 2469,\r\n                \"Telefono domicilio\": \"\",\r\n                \"Numero Celular Secundario\": \"\"\r\n            }\r\n        }\r\n    ]\r\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{fineract-backend-server}}/fineract-provider/api/v1/loanproducts",
                    "host": [
                        "{{fineract-backend-server}}"
                    ],
                    "path": [
                        "fineract-provider",
                        "api",
                        "v1",
                        "loanproducts"
                    ]
                }
            },
            "response": []
        },
