    "item": [
        {
            "name": "Get Blocking Reason Castigo",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.response.to.have.status(200);\r",
                            "pm.expect(pm.response.text()).to.not.equals( null );\r",
                            "var jsonData = JSON.parse(pm.response.text());\r",
                            "\r",
                            "// Encontra o objeto com o \"nameOfReason\" igual a \"CASTIGO\"\r",
                            "const castigoRecord = jsonData.find(record => record.nameOfReason === \"CASTIGO\");\r",
                            "\r",
                            "// Se o registro for encontrado, salva o 'id' em uma variável de ambiente\r",
                            "if (castigoRecord) {\r",
                            "    pm.environment.set(\"castigoId\", castigoRecord.id);\r",
                            "    console.log(\"ID do 'CASTIGO' salvo na variável 'id_castigo': \" + castigoRecord.id);\r",
                            "} else {\r",
                            "    console.log(\"Registro 'CASTIGO' não encontrado na resposta.\");\r",
                            "}"
                        ],
                        "type": "text/javascript",
                        "packages": {}
                    }
                },
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            ""
                        ],
                        "type": "text/javascript",
                        "packages": {}
                    }
                }
            ],
            "protocolProfileBehavior": {
                "disableBodyPruning": true
            },
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{authorization_token}}",
                        "type": "text"
                    },
                    {
                        "key": "Fineract-Platform-TenantId",
                        "value": "default",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\r\n    \"transactionDate\": \"18/07/2025\",\r\n    \"transactionAmount\": 200000,\r\n    \"honorariosAmount\": 0,\r\n    \"externalId\": \"\",\r\n    \"paymentTypeId\": 1,\r\n    \"note\": \"\",\r\n    \"channelName\": \"03 - Oficina BCS\",\r\n    \"repaymentBankId\": \"\",\r\n    \"pointOfSalesCode\": \"\",\r\n    \"reduceInstallmentAmount\": true,\r\n    \"dateFormat\": \"dd/MM/yyyy\",\r\n    \"locale\": \"es\"\r\n}",
                    "options": {
