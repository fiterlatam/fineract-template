        {
            "name": "Create Gac",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {\r",
                            "    pm.expect(pm.response.code).to.equal(200);\r",
                            "});\r",
                            "\r",
                            "pm.test(\"Response contains resourceId greater than 0\", function () {\r",
                            "    const responseJson = pm.response.json();\r",
                            "    pm.expect(responseJson.resourceId).to.exist;\r",
                            "    pm.expect(responseJson.resourceId).to.be.above(0);\r",
                            "    pm.environment.set(\"gacId\", responseJson.resourceId);\r",
                            "});\r",
                            "\r",
                            "pm.test(\"GAC ID saved to environment variable\", function () {\r",
                            "    const savedGacId = pm.environment.get(\"gacId\");\r",
                            "    pm.expect(savedGacId).to.equal(pm.response.json().resourceId);\r",
                            "    console.log(\"GAC ID saved:\", savedGacId);\r",
                            "});"
                        ],
                        "type": "text/javascript",
                        "packages": {},
                        "requests": {}
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{authorization_token}}",
                        "type": "text"
                    },
                    {
                        "key": "Fineract-Platform-TenantId",
                        "value": "default",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\r\n  \"classification\": \"GAC TEST4\",\r\n  \"minimumAgeDays\": 10001,\r\n  \"maximumAgeDays\": 10005,\r\n  \"percentageValue\": 20,\r\n  \"blockingReasonId\": {{castigoId}},\r\n  \"locale\": \"es\"\r\n}\r\n",
                    "options": {
