<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_collection_house_history" schemaName="public"/>
            </not>
        </preConditions>
        <createTable schemaName="public" tableName="m_collection_house_history">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="client_account_number" type="varchar(20)"/>
            <column name="collection_house_code" type="varchar(20)"/>
            <column type="varchar(20)" name="collection_nit"/>
            <column name="created_on_utc" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="client_account_number" tableName="m_collection_house_history"/>
    </changeSet>
    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM c_external_service WHERE name = 'COLLECTION_HOUSE_HISTORY_PROVIDER'
                </sqlCheck>
        </preConditions>
        <insert tableName="c_external_service">
            <column name="name" value="COLLECTION_HOUSE_HISTORY_PROVIDER"/>
        </insert>
    </changeSet>
    <changeSet author="fineract" id="3">
        <preConditions onFail="MARK_RAN">
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM c_external_service_properties WHERE name = 'COLLECTION_HOUSE_URL'
                </sqlCheck>
        </preConditions>
        <insert tableName="c_external_service_properties">
            <column name="name" value="COLLECTION_HOUSE_URL"/>
            <column name="value" value="https://sumas-dev.fiter.io/fineract-provider/api/v1/collectionhousehistory"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='COLLECTION_HOUSE_HISTORY_PROVIDER')"/>
        </insert>
    </changeSet>
    <changeSet author="fineract" id="4">
        <preConditions onFail="MARK_RAN">
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM c_external_service_properties WHERE name = 'COLLECTION_HOUSE_API_KEY'
                </sqlCheck>
        </preConditions>
        <insert tableName="c_external_service_properties">
            <column name="name" value="COLLECTION_HOUSE_API_KEY"/>
            <column name="value" value="9aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890AbCdEfGhIjKlMnOpQrStUvWxYz"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='COLLECTION_HOUSE_HISTORY_PROVIDER')"/>
        </insert>
    </changeSet>
    <changeSet author="fineract" id="5">
        <insert tableName="job">
            <column name="name" value="Casas de Cobro para Clientes"/>
            <column name="display_name" value="Casas de Cobro para Clientes"/>
            <column name="cron_expression" value="0 1 0 1/1 * ? *"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Casas de Cobro para ClientesJobDetail1 _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
