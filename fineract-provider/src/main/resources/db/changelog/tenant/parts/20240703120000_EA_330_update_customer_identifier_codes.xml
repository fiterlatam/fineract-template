<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="20240703120000-ea_330-update-cc" author="fineract">
        <update tableName="m_code_value">
            <column name="code_value" value="CC"/>
            <column name="code_description" value="Cédula de ciudadanía"/>
            <where>code_id = (SELECT id FROM m_code WHERE code_name = 'Customer Identifier') AND code_value = 'Cédula de ciudadanía'</where>
        </update>
    </changeSet>

    <changeSet id="20240703120000-ea_330-update-ce" author="fineract">
        <update tableName="m_code_value">
            <column name="code_value" value="CE"/>
            <column name="code_description" value="Cédula extranjeria"/>
            <where>code_id = (SELECT id FROM m_code WHERE code_name = 'Customer Identifier') AND code_value = 'Cédula extranjeria'</where>
        </update>
    </changeSet>

</databaseChangeLog>
