<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="1" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_prequalification_group_members" indexName="idx_mpgm_group_id"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_prequalification_group_members
                    ADD INDEX idx_mpgm_group_id (group_id);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="2" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_prequalification_status_log" indexName="idx_pqsl_pq_status_id"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_prequalification_status_log
                    ADD INDEX idx_pqsl_pq_status_id (prequalification_id, to_status, id);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="3" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_checklist_validation_result" indexName="idx_mcvr_pq_id"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_checklist_validation_result
                    ADD INDEX idx_mcvr_pq_id (prequalification_id);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="4" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_group" indexName="idx_group_pq_id"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_group
                    ADD INDEX idx_group_pq_id (prequalification_id);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="5" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_prequalification_group" indexName="idx_pq_status_type"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_prequalification_group
                    ADD INDEX idx_pq_status_type (status, prequalification_type_enum),
                    ADD INDEX idx_pq_center_id (center_id);
            ]]>
        </sql>
    </changeSet>

</databaseChangeLog>
