<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet id="7" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM stretchy_parameter WHERE parameter_name = 'PaidSelected'
            </sqlCheck>
        </preConditions>
        <update tableName="stretchy_parameter" >
            <column name="parameter_name" value="PaidSelected"/>
            <column name="parameter_variable" value="isPaid"/>
            <column name="parameter_label" value="Pagado / Sin Pagar"/>
            <column name="parameter_displayType" value="select"/>
            <column name="parameter_FormatType" value="text"/>
            <column name="parameter_default" value="false"/>
            <column name="special"/>
            <column name="selectOne"/>
            <column name="selectAll" value="Y"/>
            <column name="parameter_sql">
                <![CDATA[
                SELECT val, status
                FROM (
                    SELECT true as val ,'Pagado' AS status
                    UNION
                    SELECT false as val, 'Sin Pagar' AS status
                ) AS statusPaid
                ]]>
            </column>
            <column name="parent_id"/>
            <where>parameter_name ='PaidSelected'</where>
        </update>
    </changeSet>
</databaseChangeLog>
