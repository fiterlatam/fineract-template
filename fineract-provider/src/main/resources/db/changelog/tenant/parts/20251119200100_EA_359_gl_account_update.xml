    <changeSet id="10" author="fineract">
        <sql>
            <![CDATA[
                update acc_gl_account aga
                set "gl_code" = 'oldcode'
                where id = 1690952007;

                INSERT INTO acc_gl_account
                (id, "name", parent_id, "hierarchy", gl_code, disabled, manual_journal_entries_allowed, account_usage, classification_enum, tag_id, description)
                SELECT
                    24,
                    'CxC Comisión FNG',
                    NULL,
                    NULL,
                    '1690952007',
                    false,
                    true,
                    1,
                    1,
                    NULL,
                    NULL
                WHERE NOT EXISTS (
                    SELECT 1 FROM acc_gl_account WHERE id = 24
                );

                update acc_gl_journal_entry
                set account_id = 24
                where account_id = 1690952007;

                update acc_product_mapping apm
                set gl_account_id = 24
                where gl_account_id = 1690952007;

                update m_charge
                set income_or_liability_account_id = 24
                where income_or_liability_account_id = 1690952007;

                delete from acc_gl_account aga
                where id = 1690952007;
            ]]>
        </sql>
    </changeSet>
