<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="10" author="fineract">
        <sql>
            <![CDATA[
                -- Remove columns
                ALTER TABLE campos_cliente_empresas
                    DROP COLUMN "Regimen IVA_cd_Regimen IVA",
                    DROP COLUMN "Retencion",
                    DROP COLUMN "Negocio_cd_Negocio",
                    DROP COLUMN "Categoria_cd_Categoria",
                    DROP COLUMN "NIT confirming";

                -- Turn to optional columns
                ALTER TABLE campos_cliente_empresas
                    ALTER COLUMN "Segmento_cd_Segmento" DROP NOT NULL,
                    ALTER COLUMN "CIIU_cd_CIIU" DROP NOT NULL;
            ]]>
        </sql>
    </changeSet>

</databaseChangeLog>
