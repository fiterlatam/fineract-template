<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="1" author="fineract" >
        <comment>Create Detalles de la transacción table with timestamps</comment>

        <!-- Create the main table -->
        <createTable tableName="detalles_de_la_transaccion">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="identifier_transaction_channel" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="bank_number_transaction_channel" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="account_type" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="account_number_transaction" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="receipt_number" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="check_number_transaction" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="account_name_transaction" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="routing_number_transaction" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="business_establishment_name" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="id_establishment" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="disbursement_type" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="loan_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Add foreign key constraint -->
        <addForeignKeyConstraint baseTableName="detalles_de_la_transaccion"
                                 baseColumnNames="loan_transaction_id"
                                 constraintName="FK_trans_details_transaction"
                                 referencedTableName="m_loan_transaction"
                                 referencedColumnNames="id"/>

        <!-- Register the table in x_registered_table -->
        <insert tableName="x_registered_table">
            <column name="registered_table_name" value="detalles_de_la_transaccion"/>
            <column name="application_table_name" value="m_loan_transaction"/>
            <column name="category" value="100"/>
        </insert>

        <!-- Add indexes for better performance -->
        <createIndex tableName="detalles_de_la_transaccion" indexName="idx_trans_details_transaction_id">
            <column name="loan_transaction_id"/>
        </createIndex>
    </changeSet>

    <!-- Rollback -->
    <changeSet id="2" author="fineract">
        <comment>Add rollback SQL in case we need to undo these changes</comment>
        <rollback>
            <dropTable tableName="detalles_de_la_transaccion"/>
            <delete tableName="x_registered_table">
                <where>registered_table_name='detalles_de_la_transaccion'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
