<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="20240708120000-EA-332-add-gl-account-FNG-commission" author="fineract">
        <sql splitStatements="false">
            <![CDATA[
DO $$
DECLARE gl_exists BOOLEAN;
BEGIN
    SELECT EXISTS(SELECT 1 FROM acc_gl_account WHERE gl_code = '1690952007') INTO gl_exists;
    IF NOT gl_exists THEN
        INSERT INTO acc_gl_account
            (id, gl_code, name, classification_enum, account_usage, manual_journal_entries_allowed, disabled, parent_id)
        VALUES
            (1690952007, '1690952007', 'CxC Comisión FNG', 1, 1, true, false, NULL);
    END IF;
END
$$;
            ]]>
        </sql>
    </changeSet>
</databaseChangeLog>
