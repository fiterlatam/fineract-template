<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="1" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_client" indexName="idx_client_dpi"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_client
                    ADD INDEX idx_client_dpi (dpi);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="2" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_client_blacklist" indexName="idx_blacklist_dpi_status"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_client_blacklist
                    ADD INDEX idx_blacklist_dpi_status (dpi, status);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="3" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_loan" indexName="idx_loan_client_id"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_loan
                    ADD INDEX idx_loan_client_id (client_id);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="4" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_checklist_validation_result" indexName="idx_mcvr_member_type_color"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_checklist_validation_result
                    ADD INDEX idx_mcvr_member_type_color (prequalification_member_id, prequalification_type, validation_color_enum);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="5" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_loan" indexName="idx_loan_prequalification_client"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_loan
                    ADD INDEX idx_loan_prequalification_client (prequalification_id, client_id);
            ]]>
        </sql>
    </changeSet>

    <changeSet id="6" author="Fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_document" indexName="idx_document_parent_entity"/>
            </not>
        </preConditions>
        <sql>
            <![CDATA[
                ALTER TABLE m_document
                    ADD INDEX idx_document_parent_entity (parent_entity_id);
            ]]>
        </sql>
    </changeSet>

</databaseChangeLog>
