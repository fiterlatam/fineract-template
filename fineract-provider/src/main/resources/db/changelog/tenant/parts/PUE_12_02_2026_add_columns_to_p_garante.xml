<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- ========================================================= -->
    <!-- creditRecordPDAOptions -->
    <!-- ========================================================= -->
    <changeSet author="aocampo" id="001-creditRecordPDAOptions-01">
        <preConditions onFail="MARK_RAN">

            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_code WHERE code_name = 'creditRecordPDAOptions'
            </sqlCheck>

        </preConditions>
        <insert tableName="m_code">
            <column name="code_name" value="creditRecordPDAOptions"/>
            <column name="is_system_defined" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="aocampo" id="002-creditRecordPDAOptions-02">

        <sql>
            INSERT INTO m_code_value (code_id, code_value, code_description, order_position, code_score, is_active, is_mandatory)
            SELECT c.id, '&lt; 30 días de atraso', '&lt; 30 días de atraso', 1, 1, 1, 0
            FROM m_code c
            WHERE c.code_name = 'creditRecordPDAOptions'
            AND NOT EXISTS (SELECT 1 FROM m_code_value v WHERE v.code_id=c.id AND v.code_value='&lt; 30 días de atraso');
        </sql>

        <sql>
            INSERT INTO m_code_value (code_id, code_value, code_description, order_position, code_score, is_active, is_mandatory)
            SELECT c.id, '&gt; 30 días de atraso', '&gt; 30 días de atraso', 2, 2, 1, 0
            FROM m_code c
            WHERE c.code_name='creditRecordPDAOptions'
            AND NOT EXISTS (SELECT 1 FROM m_code_value v WHERE v.code_id=c.id AND v.code_value='&gt; 30 días de atraso');
        </sql>

        <sql>
            INSERT INTO m_code_value (code_id, code_value, code_description, order_position, code_score, is_active, is_mandatory)
            SELECT c.id, 'No aplica', 'No aplica', 3, 3, 1, 0
            FROM m_code c
            WHERE c.code_name='creditRecordPDAOptions'
            AND NOT EXISTS (SELECT 1 FROM m_code_value v WHERE v.code_id=c.id AND v.code_value='No aplica');
        </sql>

    </changeSet>

    <changeSet author="aocampo" id="003-add-columns_p_garante_real_state">
        <addColumn tableName="p_garante">
            <column name="creditRecordPDAOptions_cd_antiguedad_negocio" type="integer"/>
        </addColumn>
        <addColumn tableName="p_garante">
            <column name="fecha_avaluo" type="DATE"/>
        </addColumn>
        <addColumn tableName="p_garante">
            <column name="YesNo_cd_is_real_estate_owned_by_a_third_party" type="integer"/>
        </addColumn>
        <addColumn tableName="p_garante">
            <column name="YesNo_cd_is_registered_real_estate" type="integer"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
