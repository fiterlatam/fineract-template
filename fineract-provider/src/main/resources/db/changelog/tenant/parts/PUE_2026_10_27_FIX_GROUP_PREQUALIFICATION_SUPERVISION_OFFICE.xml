<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Group prequalifications created with a NULL supervision office or with the office of a sibling agency
         (MIN child office of the region) are hidden from the agency's list. Re-resolve them to the agency's office. -->
    <changeSet id="1" author="Fiter">
        <sql>
            <![CDATA[
                UPDATE m_prequalification_group g
                INNER JOIN (
                    SELECT ma.id AS agency_id,
                        COALESCE(
                            (SELECT MIN(ms.linked_office_id) FROM m_supervision ms WHERE ms.agency_id = ma.id),
                            ma.linked_office_id) AS supervision_office_id
                    FROM m_agency ma
                ) agencyOffice ON agencyOffice.agency_id = g.agency_id
                SET g.supervision_office_id = agencyOffice.supervision_office_id
                WHERE g.prequalification_type_enum = 2
                  AND agencyOffice.supervision_office_id IS NOT NULL
                  AND NOT (g.supervision_office_id <=> agencyOffice.supervision_office_id);
            ]]>
        </sql>
    </changeSet>

</databaseChangeLog>
