<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_loan_transaction" columnName="honorarios_portion_derived"/>
            </not>
        </preConditions>
        <addColumn tableName="m_loan_transaction">
            <column name="honorarios_portion_derived" type="decimal(19,6)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>


    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_loan_transaction" columnName="honorarios_vat_portion_derived"/>
            </not>
        </preConditions>
        <addColumn tableName="m_loan_transaction">
            <column name="honorarios_vat_portion_derived" type="decimal(19,6)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="3">
        <sql>
            <![CDATA[
                WITH charge_calculations AS (
                    SELECT
                        mlcpd.loan_transaction_id,
                        SUM(CASE
                            WHEN mlc.charge_calculation_enum = 1009 THEN mlcpd.amount
                            ELSE 0
                        END) AS hono_base,
                        SUM(CASE
                            WHEN mc.charge_calculation_enum = 342
                            AND parent.charge_calculation_enum = 1009 THEN mlcpd.amount
                            ELSE 0
                        END) AS hono_vat
                    FROM m_loan_charge_paid_by mlcpd
                    INNER JOIN m_loan_charge mlc ON mlc.id = mlcpd.loan_charge_id
                    INNER JOIN m_loan_transaction mlt_filter ON mlt_filter.id = mlcpd.loan_transaction_id
                    LEFT JOIN m_charge mc ON mc.id = mlc.charge_id
                    LEFT JOIN m_charge parent ON parent.id = mc.parent_charge_id
                    GROUP BY mlcpd.loan_transaction_id
                )
                UPDATE m_loan_transaction
                SET
                    honorarios_portion_derived = COALESCE(cc.hono_base, 0),
                    honorarios_vat_portion_derived = COALESCE(cc.hono_vat, 0)
                FROM m_loan l
                INNER JOIN m_loan_transaction tr ON tr.loan_id = l.id
                LEFT JOIN charge_calculations cc ON cc.loan_transaction_id = tr.id
                WHERE
                    m_loan_transaction.id = tr.id
                    AND tr.is_reversed = FALSE
                    AND tr.transaction_type_enum IN (2, 29, 6)
                    AND (COALESCE(cc.hono_base, 0) > 0 OR COALESCE(cc.hono_vat, 0) > 0);
            ]]>
        </sql>
    </changeSet>
</databaseChangeLog>
